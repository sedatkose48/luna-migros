{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet publish MigrosFinalProject/MigrosFinalProject/MigrosFinalProject.csproj -c Release -o out"
  },
  "deploy": {
    "startCommand": "dotnet out/MigrosFinalProject.dll",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
