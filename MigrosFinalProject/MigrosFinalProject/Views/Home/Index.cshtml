<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LUNA - Çözüm Mimarisi Kataloğu</title>
    
    <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
    <script>
        mermaid.initialize({ 
            startOnLoad: true, 
            theme: 'dark',
            themeVariables: { primaryColor: '#0d1635', edgeColor: '#3a7bd5', lineColor: '#22d3ee', fontFamily: 'Poppins' }
        });
    </script>
    
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <!-- Lenis Smooth Scroll CDN -->
    <script src="https://unpkg.com/@@studio-freight/lenis@@1.0.42/dist/lenis.min.js"></script>
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Poppins:wght@300;500;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        /* === 1. TEMEL DEĞİŞKENLER VE SIFIRLAMA === */
        :root {
            --bg-deep: #050914; --bg-glow: #0b132b;
            --card-bg: rgba(13, 22, 53, 0.65); --card-border: rgba(70, 130, 255, 0.4);
            --text-main: #ffffff; --text-muted: #a0b0d0;
            --gold-gradient: linear-gradient(90deg, #fceabb, #f8b500);
            --blue-accent: #3a7bd5; --cyan-accent: #22d3ee; --green-accent: #34d399;
            --red-accent: #ef4444; --yellow-accent: #eab308; --orange-accent: #f97316;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: var(--bg-deep); background-image: radial-gradient(circle at 50% 50%, var(--bg-glow) 0%, var(--bg-deep) 100%);
            color: var(--text-main); font-family: 'Poppins', sans-serif;
            overflow-x: hidden; min-height: 100vh; display: flex; flex-direction: column;
            align-items: center; position: relative;
        }
        .content-wrapper { position: relative; z-index: 1; width: 100%; max-width: 1400px; display: flex; flex-direction: column; align-items: center; padding: 2rem 1rem; }
        .header { margin-bottom: 3rem; text-align: center; animation: slideDown 1s ease-out; }
        .header h1 { font-family: 'Montserrat', sans-serif; font-size: 2.5rem; font-weight: 900; letter-spacing: 2px; line-height: 1.1; text-transform: uppercase; }
        .header h1 .gold-text { background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-shadow: 0px 0px 20px rgba(248, 181, 0, 0.3); display: block; }
        .section-title { font-family: 'Montserrat', sans-serif; font-size: 1.8rem; font-weight: 700; color: var(--cyan-accent); margin: 3rem 0 2rem; text-align: left; text-transform: uppercase; border-left: 5px solid var(--cyan-accent); padding-left: 1rem; width: 100%; }

        #particles-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.2); border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: rgba(70, 130, 255, 0.4); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(34, 211, 238, 0.8); }

        /* === BÖLÜM 1-3: 3M, EBO, RACI STİLLERİ === */
        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; width: 100%; margin-bottom: 2rem;}
        .analysis-card { background: var(--card-bg); border: 1px solid rgba(255,255,255,0.1); padding: 1.5rem; border-radius: 15px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
        .analysis-card.muda { border-left: 4px solid var(--red-accent); }
        .analysis-card.mura { border-left: 4px solid var(--yellow-accent); }
        .analysis-card.muri { border-left: 4px solid var(--orange-accent); }
        
        .card-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.5rem; }
        .card-header h3 { font-family: 'Montserrat'; font-size: 1.1rem; color: #fff; }
        .card-badge { padding: 3px 8px; border-radius: 5px; font-size: 0.75rem; font-weight: bold; }
        .badge-red { background: rgba(239, 68, 68, 0.15); color: var(--red-accent); }
        .analysis-card p { font-size: 0.85rem; color: #cbd5e1; line-height: 1.5; }
        .analysis-card ul { padding-left: 1rem; }
        .analysis-card li { font-size: 0.85rem; color: #cbd5e1; margin-bottom: 0.3rem;}

        .ebo-container { width: 100%; display: flex; flex-direction: column; gap: 2rem; margin-bottom: 2rem;}
        .data-table { width: 100%; border-collapse: collapse; background: var(--card-bg); font-size: 0.85rem; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
        .data-table th, .data-table td { padding: 1rem; text-align: left; border: 1px solid rgba(255,255,255,0.05); color: #cbd5e1;}
        .data-table td strong { color: #fff; }
        .table-eliminate th { background: linear-gradient(90deg, rgba(239, 68, 68, 0.2), transparent); color: var(--red-accent); border-bottom: 2px solid var(--red-accent); }
        .table-simplify th { background: linear-gradient(90deg, rgba(59, 130, 246, 0.2), transparent); color: var(--blue-accent); border-bottom: 2px solid var(--blue-accent); }
        .table-optimize th { background: linear-gradient(90deg, rgba(34, 197, 94, 0.2), transparent); color: var(--green-accent); border-bottom: 2px solid var(--green-accent); }

        .matrix-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; width: 100%; background: var(--card-bg); padding: 1.5rem; border-radius: 15px; border: 1px solid var(--cyan-accent); box-shadow: 0 10px 30px rgba(0,0,0,0.3); margin-bottom: 2rem;}
        .matrix-cell { padding: 1.5rem; border-radius: 12px; background: rgba(0,0,0,0.4); border: 1px dashed rgba(255,255,255,0.2); }
        .matrix-cell h4 { font-family: 'Montserrat'; font-size: 0.95rem; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; }
        .matrix-cell ul { list-style: none; font-size: 0.85rem; color: #cbd5e1; }
        .matrix-cell li { margin-bottom: 0.5rem; padding-left: 15px; position: relative; }
        .matrix-cell li::before { content: "▸"; position: absolute; left: 0; color: var(--cyan-accent); }

        .raci-table th { background: rgba(34, 211, 238, 0.1); color: var(--cyan-accent); text-align: center; }
        .raci-table td { text-align: center; }
        .raci-table td:first-child { text-align: left; font-weight: 500; color: #fff; }
        .r-A { background: rgba(239, 68, 68, 0.15); color: var(--red-accent); padding: 5px 10px; border-radius: 5px; font-weight: bold; }
        .r-R { background: rgba(245, 158, 11, 0.15); color: var(--yellow-accent); padding: 5px 10px; border-radius: 5px; font-weight: bold; }
        .r-C { background: rgba(59, 130, 246, 0.15); color: var(--blue-accent); padding: 5px 10px; border-radius: 5px; font-weight: bold; }
        .r-I { background: rgba(148, 163, 184, 0.15); color: #94a3b8; padding: 5px 10px; border-radius: 5px; font-weight: bold; }

        /* === BÖLÜM 4: PERSONA, EMPATİ & HMW === */
        .persona-wrapper { width: 100%; display: grid; grid-template-columns: 350px 1fr 350px; gap: 1.5rem; align-items: stretch; margin-bottom: 5rem;}
        .prs-col { background: #0d1635; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; box-shadow: 0 15px 35px rgba(0,0,0,0.5); display: flex; flex-direction: column; }
        .prs-col.border-cyan { border-color: var(--cyan-accent); }
        .prs-col.border-blue { border-color: var(--blue-accent); }
        .prs-col.border-gold { border-color: #f8b500; }

        .prs-badge { background: rgba(34, 211, 238, 0.1); color: var(--cyan-accent); padding: 0.3rem 0.8rem; border-radius: 5px; font-weight: 700; font-size: 0.8rem; display: inline-block; margin-bottom: 1rem; align-self: flex-start;}
        .prs-name { font-family: 'Montserrat', sans-serif; font-size: 2.5rem; font-weight: 900; color: #fff; margin-bottom: 0.5rem; line-height: 1; }
        .prs-title { font-size: 1.1rem; color: var(--cyan-accent); font-weight: 500; margin-bottom: 2rem; }
        .prs-quote-main { border-left: 4px solid var(--cyan-accent); padding-left: 1rem; font-style: italic; color: #e2e8f0; margin-bottom: 2rem; font-size: 0.95rem; line-height: 1.5;}
        .prs-info-grid { display: grid; grid-template-columns: 90px 1fr; gap: 0.8rem 0; margin-bottom: 2rem; font-size: 0.85rem; }
        .prs-info-label { color: var(--text-muted); font-weight: 700; }
        .prs-info-val { color: #fff; font-weight: 500; }
        .prs-list-title { font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: var(--cyan-accent); margin-bottom: 1rem; font-weight: 700; text-transform: uppercase; margin-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;}
        .prs-list ul { list-style: none; }
        .prs-list li { margin-bottom: 0.6rem; font-size: 0.8rem; color: #cbd5e1; display: flex; align-items: flex-start; gap: 8px; line-height: 1.4;}
        .prs-list .check { color: var(--green-accent); font-weight: bold; }
        .prs-list .cross { color: #ff4b4b; font-weight: bold; }

        .emp-header { text-align: center; margin-bottom: 2rem; flex: 0 0 auto; }
        .emp-header h3 { color: var(--text-muted); font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;}
        .emp-header h2 { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; color: var(--blue-accent); font-weight: 900; text-transform: uppercase; }
        .emp-map-container { display: flex; flex-direction: column; gap: 1.5rem; width: 100%; flex-grow: 1; justify-content: space-between;}
        .emp-middle-row { display: flex; align-items: stretch; justify-content: space-between; gap: 1rem; width: 100%; flex: 1; }
        .emp-bottom-row { display: flex; align-items: stretch; gap: 1rem; width: 100%; flex: 1; }
        .emp-avatar { flex-shrink: 0; display: flex; justify-content: center; align-items: center; padding: 0 10px;}
        .emp-avatar img { width: 120px; height: 120px; border-radius: 50%; border: 4px solid var(--blue-accent); box-shadow: 0 0 15px rgba(58, 123, 213, 0.4); object-fit: cover; }
        .emp-box { background: rgba(0,0,0,0.3); padding: 1.2rem; border-radius: 12px; border-left: 3px solid var(--blue-accent); }
        .emp-box.thinks { flex: 0 0 auto; border-color: #a855f7; } 
        .emp-middle-row .emp-box, .emp-bottom-row .emp-box { flex: 1; } 
        .emp-box.sees { border-color: #3b82f6; } .emp-box.hears { border-color: #eab308; } .emp-box.does { border-color: #22c55e; } .emp-box.feels { border-color: #ef4444; }
        .emp-box-title { font-weight: 700; font-size: 0.85rem; margin-bottom: 0.6rem; display: flex; align-items: center; gap: 6px; text-transform: uppercase;}
        .thinks .emp-box-title { color: #a855f7; } .sees .emp-box-title { color: #3b82f6; } .hears .emp-box-title { color: #eab308; } .does .emp-box-title { color: #22c55e; } .feels .emp-box-title { color: #ef4444; }
        .emp-box ul { list-style: none; padding: 0; }
        .emp-box li { font-size: 0.8rem; color: #cbd5e1; margin-bottom: 0.5rem; padding-left: 12px; position: relative; line-height: 1.4; }
        .emp-box li::before { content: "•"; position: absolute; left: 0; top: 0; font-size: 1rem; line-height: 1;}
        .thinks li::before { color: #a855f7; } .sees li::before { color: #3b82f6; } .hears li::before { color: #eab308; } .does li::before { color: #22c55e; } .feels li::before { color: #ef4444; }

        .hmw-header { text-align: center; margin-bottom: 2rem; flex: 0 0 auto; }
        .hmw-header h3 { color: var(--text-muted); font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;}
        .hmw-header h2 { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; color: #f8b500; font-weight: 900; text-transform: uppercase; }
        .hmw-item { background: rgba(0,0,0,0.4); padding: 1.5rem 1.2rem; border-radius: 12px; margin-bottom: 1rem; font-size: 0.9rem; color: #fff; border-left: 4px solid #f8b500; line-height: 1.6; box-shadow: inset 0 0 10px rgba(248, 181, 0, 0.05); flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .hmw-item:last-child { margin-bottom: 0; }
        .hmw-item strong { color: #f8b500; display: block; margin-bottom: 5px; font-size: 0.95rem;}
        .hmw-item i { color: var(--text-muted); display: block; margin-top: 8px; font-size: 0.8rem; }

        /* === BÖLÜM 5: USER STORY (PANEL MANTIĞI) === */
        .story-nav { display: flex; align-items: center; justify-content: center; gap: 2rem; margin-bottom: 1rem; width: 100%; max-width: 850px; }
        .nav-btn { background: rgba(70, 130, 255, 0.1); border: 1px solid var(--card-border); color: #fff; font-size: 1.5rem; width: 45px; height: 45px; border-radius: 50%; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(70, 130, 255, 0.2); }
        .nav-btn:hover { background: rgba(70, 130, 255, 0.3); transform: scale(1.1); box-shadow: 0 0 20px var(--cyan-accent); }
        .story-indicator { font-family: 'Montserrat', sans-serif; font-weight: 700; color: var(--cyan-accent); letter-spacing: 2px; font-size: 1.1rem;}

        .main-stage { display: flex; gap: 2rem; width: 100%; justify-content: center; align-items: flex-start; transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1); margin-bottom: 5rem; }
        .story-wrapper { width: 100%; max-width: 850px; transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1); }
        .main-stage.panel-active .story-wrapper { max-width: 680px; }
        .story-board { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 2rem; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5); position: relative; overflow: hidden; min-height: 420px; }
        
        .fade-content { opacity: 1; transition: opacity 0.3s ease, transform 0.3s ease; transform: translateY(0); }
        .fade-out { opacity: 0; transform: translateY(10px); }

        .story-row { display: flex; align-items: center; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 1.2rem; margin-bottom: 1.2rem; transition: all 0.3s ease; }
        .story-row:hover { transform: translateX(10px); background: rgba(70, 130, 255, 0.1); border-color: rgba(70, 130, 255, 0.3); box-shadow: 0 0 20px rgba(70, 130, 255, 0.2); }
        .row-left { display: flex; align-items: center; gap: 15px; width: 240px; font-family: 'Montserrat', sans-serif; font-size: 1.2rem; font-weight: 700; }
        .row-icon { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--card-border); display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05); box-shadow: 0 0 15px rgba(70, 130, 255, 0.3); }
        .row-label-sub { font-size: 0.75rem; color: var(--text-muted); font-weight: 300; margin-left: 5px; }
        .arrow { color: var(--blue-accent); font-size: 1.5rem; font-weight: bold; margin-right: 15px; }
        .row-right { flex: 1; font-size: 0.95rem; line-height: 1.5; }
        .highlight { color: #f8b500; font-weight: 700; }

        .action-buttons { display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: center; }
        .btn { background: rgba(13, 22, 53, 0.8); border: 1px solid var(--card-border); color: var(--text-main); font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.9rem; padding: 0.8rem 1.5rem; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
        .btn:hover, .btn.active { background: rgba(70, 130, 255, 0.2); border-color: var(--cyan-accent); box-shadow: 0 0 20px rgba(34, 211, 238, 0.4); transform: translateY(-2px); }

        .side-panel { width: 0; opacity: 0; visibility: hidden; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 0; backdrop-filter: blur(12px); transform: translateX(50px); transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1); overflow-y: auto; max-height: 600px; }
        .main-stage.panel-active .side-panel { width: 480px; opacity: 1; visibility: visible; transform: translateX(0); padding: 2rem; }
        .panel-content { display: none; animation: fadeIn 0.5s ease forwards; }
        .panel-content.active { display: block; }
        .panel-title { font-family: 'Montserrat', sans-serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--cyan-accent); border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; }
        .close-btn { background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer; transition: color 0.3s; }
        .invest-grid { display: grid; grid-template-columns: 1fr; gap: 0.8rem; }
        .invest-item { background: rgba(0,0,0,0.3); border-left: 3px solid var(--gold-gradient); padding: 0.8rem 1rem; border-radius: 0 8px 8px 0; display: flex; align-items: center; gap: 15px; }
        .invest-letter { font-family: 'Montserrat', sans-serif; font-size: 1.5rem; font-weight: 900; color: #f8b500; width: 30px; text-align: center; text-shadow: 0 0 10px rgba(248, 181, 0, 0.5); }
        .invest-desc strong { color: var(--text-main); font-size: 0.9rem; display: block; }
        .invest-desc span { color: var(--text-muted); font-size: 0.8rem; }
        .gherkin-scenario { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 1.2rem; margin-bottom: 1.2rem; }
        .scenario-title { font-size: 0.9rem; font-weight: 700; color: #fff; margin-bottom: 10px; display: block; }
        .g-line { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; margin-bottom: 6px; line-height: 1.5; }
        .g-line .kw { font-weight: 700; display: inline-block; width: 55px; }
        .g-given .kw { color: #f8b500; } .g-when .kw { color: var(--cyan-accent); } .g-then .kw { color: var(--green-accent); }

        /* === 6. UML MİMARİSİ BÖLÜMÜ === */
        .architecture-stage { display: flex; gap: 2rem; width: 100%; justify-content: space-between; align-items: stretch; margin-bottom: 5rem; }
        .uml-container { flex: 1; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 2rem; display: flex; justify-content: center; align-items: center; overflow-x: auto; }
        .specs-container { flex: 1; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 2rem; overflow-y: auto; max-height: 600px; }
        .spec-card { background: rgba(0, 0, 0, 0.3); border-left: 4px solid var(--cyan-accent); padding: 1.5rem; border-radius: 0 12px 12px 0; margin-bottom: 1.5rem; }
        .spec-title { font-family: 'Montserrat', sans-serif; font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; }
        .spec-title span { background: rgba(34, 211, 238, 0.15); color: var(--cyan-accent); padding: 0.2rem 0.6rem; border-radius: 5px; font-size: 0.8rem; }
        .spec-line { font-size: 0.85rem; margin-bottom: 0.8rem; line-height: 1.6; }
        .spec-label { font-weight: 700; font-family: 'JetBrains Mono', monospace; display: block; margin-bottom: 0.2rem; }
        .lbl-pre { color: #f8b500; } .lbl-alt { color: var(--blue-accent); } .lbl-exc { color: #ff4b4b; } .lbl-post { color: var(--green-accent); }
        .mermaid { width: 100%; display: flex; justify-content: center; align-items: center; }

        /* === 7. STORYBOARD BÖLÜMÜ === */
        .storyboard-container { width: 100%; margin: 0 auto 5rem; display: flex; flex-direction: column; gap: 4rem; }
        .sb-section { background: rgba(10, 15, 35, 0.4); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 3rem 2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
        .sb-main-title { text-align: center; font-family: 'Montserrat', sans-serif; font-size: 2.2rem; font-weight: 900; color: #fff; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
        .sb-main-title span { color: #f8b500; text-shadow: 0 0 15px rgba(248, 181, 0, 0.4); }
        .sb-subtitle { text-align: center; color: var(--text-muted); font-size: 1rem; margin-bottom: 3rem; display: flex; align-items: center; justify-content: center; gap: 15px; }
        .sb-subtitle::before, .sb-subtitle::after { content: ""; width: 50px; height: 1px; background: rgba(255,255,255,0.2); }
        .sb-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; row-gap: 40px; }
        .sb-panel { position: relative; border-radius: 16px; background: #0d1635; display: flex; flex-direction: column; overflow: visible; }
        .sb-panel::before { content: ""; position: absolute; top: -2px; left: -2px; right: -2px; bottom: -2px; z-index: -1; border-radius: 18px; }
        .sb-panel.theme-purple::before { background: linear-gradient(135deg, #7c3aed, #4c1d95); box-shadow: 0 0 15px rgba(124, 58, 237, 0.3); }
        .sb-panel.theme-blue::before { background: linear-gradient(135deg, #2563eb, #1e3a8a); box-shadow: 0 0 15px rgba(37, 99, 235, 0.3); }
        .sb-panel.theme-green::before { background: linear-gradient(135deg, #10b981, #065f46); box-shadow: 0 0 15px rgba(16, 185, 129, 0.3); }
        .sb-panel.theme-yellow::before { background: linear-gradient(135deg, #f59e0b, #b45309); box-shadow: 0 0 15px rgba(245, 158, 11, 0.3); }
        .sb-header { display: flex; align-items: center; padding: 12px 15px; gap: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .sb-num { width: 32px; height: 32px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 1.1rem; color: #fff; background: rgba(255,255,255,0.2); }
        .theme-purple .sb-num { background: #7c3aed; } .theme-blue .sb-num { background: #2563eb; } .theme-green .sb-num { background: #10b981; } .theme-yellow .sb-num { background: #f59e0b; }
        .sb-phase { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.9rem; color: #fff; }
        .sb-image { width: 100%; aspect-ratio: 2000 / 1600; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; overflow: hidden; }
        .sb-image img { width: 100%; height: 100%; object-fit: cover; }
        .sb-footer { padding: 12px 15px; text-align: center; font-size: 0.85rem; font-weight: 500; color: #e2e8f0; border-top: 1px solid rgba(255,255,255,0.05); background: rgba(0,0,0,0.2); border-radius: 0 0 16px 16px; min-height: 45px; display: flex; align-items: center; justify-content: center; }
        .sb-arrow { position: absolute; right: -25px; top: 50%; transform: translateY(-50%); font-size: 2rem; z-index: 5; }
        .theme-purple .sb-arrow { color: #a78bfa; text-shadow: 0 0 10px #7c3aed; } .theme-blue .sb-arrow { color: #93c5fd; text-shadow: 0 0 10px #2563eb; } .theme-yellow .sb-arrow { color: #fde68a; text-shadow: 0 0 10px #f59e0b; }

        /* === 8. STORY MAPPING === */
        .mapping-container { width: 100%; overflow-x: auto; margin-bottom: 5rem; }
        .mapping-table { width: 100%; border-collapse: collapse; background: var(--card-bg); border-radius: 15px; overflow: hidden; border: 1px solid var(--card-border); }
        .mapping-table th, .mapping-table td { padding: 1.5rem; text-align: center; border: 1px solid rgba(255,255,255,0.1); }
        .mapping-table th { background: rgba(34, 211, 238, 0.1); color: var(--cyan-accent); font-family: 'Montserrat'; text-transform: uppercase; }
        .col-main { font-weight: 900; color: #fff; background: rgba(255,255,255,0.05); }
        .mvp-cell { background: rgba(52, 211, 153, 0.1); border-left: 4px solid var(--green-accent); font-weight: 700; color: var(--green-accent); }
        .figma-wrapper { 
            width: 100%; 
            max-width: 1200px; 
            margin: 0 auto 5rem; 
            background: rgba(10, 15, 35, 0.4); 
            border: 1px solid var(--cyan-accent); 
            border-radius: 24px; 
            padding: 1.5rem; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.5), inset 0 0 20px rgba(34, 211, 238, 0.05); 
            display: flex; 
            flex-direction: column;
            align-items: center;
        }
        .figma-iframe { 
            width: 100%; 
            height: 700px; 
            border-radius: 12px; 
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: #1e1e1e; 
        }

        /* === BARKOD TARAYICI SİMÜLATÖRÜ STİLLERİ === */
        .scanner-wrapper {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 2rem;
            width: 100%;
            margin-bottom: 5rem;
        }
        .scanner-canvas-container {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            height: 420px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .scanner-title {
            position: absolute;
            top: 15px;
            left: 20px;
            font-size: 0.8rem;
            color: var(--cyan-accent);
            font-family: 'Montserrat';
            font-weight: 700;
            z-index: 10;
        }
        .scan-button-container {
            position: absolute;
            bottom: 15px;
            left: 0;
            right: 0;
            display: flex;
            justify-content: center;
            gap: 10px;
            z-index: 10;
            padding: 0 15px;
        }
        .scanner-btn {
            background: rgba(13, 22, 53, 0.9);
            border: 1px solid var(--card-border);
            color: #fff;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.75rem;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .scanner-btn:hover {
            border-color: var(--cyan-accent);
            box-shadow: 0 0 10px rgba(34, 211, 238, 0.4);
            transform: translateY(-2px);
        }
        .laser-line {
            position: absolute;
            left: 0;
            width: 100%;
            height: 4px;
            background: rgba(255, 0, 0, 0.8);
            box-shadow: 0 0 15px 4px rgba(255, 0, 0, 0.8);
            z-index: 5;
            pointer-events: none;
            opacity: 0;
        }

        @@keyframes laser-sweep {
            0% { top: 10%; opacity: 1; }
            50% { top: 80%; opacity: 1; }
            100% { top: 10%; opacity: 1; }
        }

        .laser-active {
            animation: laser-sweep 2s infinite ease-in-out;
        }

        .scanner-hud-panel {
            background: rgba(5, 9, 20, 0.85);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 420px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.6);
            font-family: 'JetBrains Mono', monospace;
        }
        .hud-header {
            font-size: 0.8rem;
            color: var(--cyan-accent);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 0.5rem;
            letter-spacing: 1px;
            font-weight: 700;
        }
        .hud-terminal {
            flex-grow: 1;
            margin: 1rem 0;
            overflow-y: auto;
            font-size: 0.78rem;
            line-height: 1.6;
            color: #a7f3d0;
            padding-right: 5px;
        }
        .hud-line {
            margin-bottom: 6px;
            word-break: break-all;
        }
        .hud-line.muted { color: var(--text-muted); }
        .hud-line.warning { color: var(--yellow-accent); }
        .hud-line.error { color: #ff4b4b; font-weight: 700; text-shadow: 0 0 5px rgba(255, 75, 75, 0.3); }
        .hud-line.success { color: var(--green-accent); font-weight: 700; }
        .hud-status-box {
            padding: 12px;
            border-radius: 10px;
            text-align: center;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: 2px;
        }
        .hud-status-box.info { background: rgba(58, 123, 213, 0.2); color: var(--cyan-accent); border: 1px solid var(--blue-accent); }
        .hud-status-box.success { background: rgba(52, 211, 153, 0.15); color: var(--green-accent); border: 1px solid var(--green-accent); box-shadow: 0 0 15px rgba(52, 211, 153, 0.2); }
        .hud-status-box.warning { background: rgba(245, 158, 11, 0.15); color: var(--yellow-accent); border: 1px solid var(--yellow-accent); }
        .hud-status-box.error { background: rgba(239, 68, 68, 0.2); color: #ff4b4b; border: 1px solid #ff4b4b; box-shadow: 0 0 20px rgba(239, 68, 68, 0.3); animation: flashRed 1s infinite alternate; }

        @@keyframes flashRed {
            from { opacity: 1; }
            to { opacity: 0.6; }
        }

        @@media (max-width: 1024px) {
            .scanner-wrapper {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
        }

        /* === LENIS SMOOTH SCROLL STİLLERİ === */
        html.lenis, html.lenis body {
            height: auto;
        }
        .lenis.lenis-smooth {
            scroll-behavior: auto !important;
        }
        .lenis.lenis-smooth [data-lenis-prevent] {
            overscroll-behavior: contain;
        }
        .lenis.lenis-stopped {
            overflow: hidden;
        }
        .lenis.lenis-scrolling iframe {
            pointer-events: none;
        }

        /* === KANO MODELİ SİMÜLATÖRÜ STİLLERİ === */
        .kano-wrapper {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 2rem;
            width: 100%;
            margin-bottom: 5rem;
        }
        .kano-canvas-container {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            height: 440px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .kano-title {
            position: absolute;
            top: 15px;
            left: 20px;
            font-size: 0.8rem;
            color: var(--cyan-accent);
            font-family: 'Montserrat';
            font-weight: 700;
            z-index: 10;
        }
        .kano-hud-panel {
            background: rgba(5, 9, 20, 0.85);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 440px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.6);
            font-family: 'Poppins', sans-serif;
        }
        .kano-req-selector {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 0.8rem;
        }
        .kano-tab-btn {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            color: var(--text-muted);
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.72rem;
            cursor: pointer;
            font-family: 'Montserrat';
            font-weight: 700;
            transition: all 0.3s;
        }
        .kano-tab-btn:hover, .kano-tab-btn.active {
            color: #fff;
            background: rgba(34, 211, 238, 0.15);
            border-color: var(--cyan-accent);
            box-shadow: 0 0 10px rgba(34, 211, 238, 0.2);
        }
        .kano-tab-btn.must-be-btn.active { background: rgba(239, 68, 68, 0.15); border-color: var(--red-accent); color: var(--red-accent); }
        .kano-tab-btn.perf-btn.active { background: rgba(34, 211, 238, 0.15); border-color: var(--cyan-accent); color: var(--cyan-accent); }
        .kano-tab-btn.delight-btn.active { background: rgba(52, 211, 153, 0.15); border-color: var(--green-accent); color: var(--green-accent); }
        
        .kano-details-card {
            flex-grow: 1;
            background: rgba(0,0,0,0.4);
            border-radius: 12px;
            padding: 1.2rem;
            border: 1px solid rgba(255,255,255,0.05);
            overflow-y: auto;
            max-height: 250px;
        }
        .kano-details-header {
            font-family: 'Montserrat';
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .kano-details-category {
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 5px;
            font-weight: 800;
            text-transform: uppercase;
        }
        .kano-details-desc {
            font-size: 0.8rem;
            color: #cbd5e1;
            line-height: 1.6;
        }
        .kano-axis-label {
            position: absolute;
            font-size: 0.62rem;
            color: var(--text-muted);
            font-weight: 700;
            letter-spacing: 0.5px;
            font-family: 'Montserrat';
            z-index: 10;
        }

        @@media (max-width: 1024px) {
            .kano-wrapper {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
        }

        /* === VİZE BULGULARI VE KONSEPT STİLLERİ === */
        .vize-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 2rem;
            width: 100%;
            margin-bottom: 3rem;
        }
        .vize-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .vize-item {
            background: rgba(239, 68, 68, 0.08);
            border-left: 4px solid var(--red-accent);
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }
        .vize-item:hover {
            transform: translateX(5px);
            background: rgba(239, 68, 68, 0.12);
            box-shadow: 0 4px 20px rgba(239, 68, 68, 0.15);
        }
        .vize-icon {
            font-size: 1.5rem;
            color: var(--red-accent);
        }
        .vize-text {
            font-size: 0.9rem;
            font-weight: 500;
            color: #e2e8f0;
        }
        .result-need-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            justify-content: center;
        }
        .flow-card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            position: relative;
        }
        .flow-card.result {
            border-left: 4px solid var(--orange-accent);
        }
        .flow-card.need {
            border-left: 4px solid var(--cyan-accent);
        }
        .flow-card-title {
            font-family: 'Montserrat';
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            letter-spacing: 1px;
        }
        .flow-card.result .flow-card-title { color: var(--orange-accent); }
        .flow-card.need .flow-card-title { color: var(--cyan-accent); }
        .flow-card-body {
            font-size: 0.95rem;
            font-weight: 500;
            color: #fff;
            line-height: 1.5;
        }
        .flow-arrow {
            text-align: center;
            font-size: 1.5rem;
            color: var(--text-muted);
            margin: -0.5rem 0;
            animation: pulse-down 1.5s infinite ease-in-out;
        }
        @@keyframes pulse-down {
            0%, 100% { transform: translateY(0); opacity: 0.5; }
            50% { transform: translateY(5px); opacity: 1; }
        }
        .vize-footer-callout {
            width: 100%;
            background: linear-gradient(135deg, rgba(13, 22, 53, 0.8), rgba(58, 123, 213, 0.15));
            border: 1px solid var(--cyan-accent);
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.6;
            color: #fff;
            box-shadow: 0 0 25px rgba(34, 211, 238, 0.15);
            margin-bottom: 4rem;
        }

        /* === ÇÖZÜM KONSEPTİ STİLLERİ === */
        .concept-grid {
            display: grid;
            grid-template-columns: 1fr 1.5fr 1fr;
            gap: 1.5rem;
            width: 100%;
            margin-bottom: 4rem;
        }
        .concept-column {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .concept-col-header {
            font-family: 'Montserrat';
            font-size: 0.95rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 0.75rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .concept-column.focus { border-top: 4px solid var(--orange-accent); }
        .concept-column.focus .concept-col-header { color: var(--orange-accent); }
        .concept-column.logic { border-top: 4px solid var(--green-accent); }
        .concept-column.logic .concept-col-header { color: var(--green-accent); }
        .concept-column.market { border-top: 4px solid var(--cyan-accent); }
        .concept-column.market .concept-col-header { color: var(--cyan-accent); }

        .concept-body {
            font-size: 0.85rem;
