            font-weight: 700;
            align-self: flex-start;
            text-transform: uppercase;
        }
        .market-option-title {
            color: #fff;
            font-weight: 700;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        @@media (max-width: 1024px) {
            .vize-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            .concept-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <canvas id="particles-canvas"></canvas>

    <div class="content-wrapper">
        
        <div class="header">
            <!-- 3D Header Kübü -->
            <div id="canvas-3d-header" style="width:180px; height:180px; margin: 0 auto 1.5rem;"></div>
            <h1>LUNA PROJESİ<br><span class="gold-text">ÇÖZÜM MİMARİSİ KATALOĞU</span></h1>
        </div>

        <!-- ARA PROJE BULGULARINDAN ÇÖZÜM MİMARİSİNE BÖLÜMÜ -->
        <div class="section-title">ARA PROJE BULGULARINDAN ÇÖZÜM MİMARİSİNE (VİZE ÖZETİ)</div>
        <div class="vize-grid">
            <!-- Sol Sütun: Tespit Ettiklerimiz -->
            <div class="vize-list">
                <div style="font-family:'Montserrat'; font-size:1.1rem; font-weight:800; color:var(--red-accent); margin-bottom:0.5rem; display:flex; align-items:center; gap:8px;">
                    <i class="bi bi-exclamation-octagon-fill"></i> TESPİT ETTİKLERİMİZ
                </div>
                <div class="vize-item">
                    <i class="bi bi-chat-left-text-fill vize-icon"></i>
                    <span class="vize-text">SKT şikayetleri görünür durumda</span>
                </div>
                <div class="vize-item">
                    <i class="bi bi-shield-fill-exclamation vize-icon"></i>
                    <span class="vize-text">Kritik ürünlerde kalite riski mevcut</span>
                </div>
                <div class="vize-item">
                    <i class="bi bi-person-fill-exclamation vize-icon"></i>
                    <span class="vize-text">Süreç tamamen çalışan dikkatine bağımlı</span>
                </div>
                <div class="vize-item">
                    <i class="bi bi-calendar-x-fill vize-icon"></i>
                    <span class="vize-text">Yakın tarihli ürünler etkin yönetilemiyor</span>
                </div>
                <div class="vize-item">
                    <i class="bi bi-trash3-fill vize-icon"></i>
                    <span class="vize-text">Yüksek miktarda gıda israfı oluşuyor</span>
                </div>
            </div>

            <!-- Sağ Sütun: Sonuç ve İhtiyaç -->
            <div class="result-need-container">
                <div class="flow-card result">
                    <div class="flow-card-title"><i class="bi bi-arrow-right-circle-fill"></i> SONUÇ</div>
                    <div class="flow-card-body">Mevcut süreç reaktif çalışıyor. (Hata oluştuktan sonra müdahale ediliyor)</div>
                </div>
                
                <div class="flow-arrow"><i class="bi bi-chevron-double-down"></i></div>
                
