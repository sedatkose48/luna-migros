        // 4.1. SCENE: 3D KANO MODELİ SİMÜLATÖRÜ (YENİ BÖLÜM)
        (function() {
            const container = document.getElementById('canvas-3d-kano');
            const detailsContent = document.getElementById('kano-details-content');
            if(!container || !detailsContent) return;
            
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
            camera.position.set(0, 0.15, 10.5);
            camera.lookAt(0, 0.15, 0);
            
            const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(renderer.domElement);
            
            const kanoGroup = new THREE.Group();
            kanoGroup.scale.set(0.7, 0.7, 0.7);
            kanoGroup.position.set(0.2, 0.3, 0);
            scene.add(kanoGroup);
            
            // Kano için akıllı kontrol: merkeze yakınsa PAN, uzaksa 3D DÖNDÜRME
            (function() {
                let isDragging = false;
                let dragMode = 'none'; // 'pan' veya 'rotate'
                let prevMouse = { x: 0, y: 0 };
                const panFactor = 0.008;
                const rotateFactor = 0.005;
                const CENTER_RADIUS = 60; // piksel - merkeze bu kadar yakınsa pan modu
                
                // Eksen merkezinin ekran koordinatını hesapla
                function getOriginScreenPos() {
                    const origin = new THREE.Vector3(0, 0, 0);
                    origin.applyMatrix4(kanoGroup.matrixWorld);
                    origin.project(camera);
                    const rect = renderer.domElement.getBoundingClientRect();
                    return {
                        x: (origin.x * 0.5 + 0.5) * rect.width + rect.left,
                        y: (-origin.y * 0.5 + 0.5) * rect.height + rect.top
                    };
                }
                
                renderer.domElement.addEventListener('mousedown', (e) => {
                    isDragging = true;
                    prevMouse = { x: e.clientX, y: e.clientY };
                    
                    // Tıklanan nokta eksenlerin merkezine yakın mı?
                    const originScreen = getOriginScreenPos();
                    const dist = Math.sqrt(
                        Math.pow(e.clientX - originScreen.x, 2) + 
                        Math.pow(e.clientY - originScreen.y, 2)
                    );
                    
                    if (dist < CENTER_RADIUS) {
                        dragMode = 'pan';
                        renderer.domElement.style.cursor = 'move';
                    } else {
                        dragMode = 'rotate';
                        renderer.domElement.style.cursor = 'grabbing';
                    }
                });
                
                renderer.domElement.addEventListener('mousemove', (e) => {
                    if (!isDragging) {
                        // Hover: merkeze yakınsa imleç değiştir
                        const originScreen = getOriginScreenPos();
                        const dist = Math.sqrt(
                            Math.pow(e.clientX - originScreen.x, 2) + 
                            Math.pow(e.clientY - originScreen.y, 2)
                        );
                        renderer.domElement.style.cursor = dist < CENTER_RADIUS ? 'move' : 'grab';
                        return;
                    }
                    
                    const dx = e.clientX - prevMouse.x;
                    const dy = e.clientY - prevMouse.y;
                    
                    if (dragMode === 'pan') {
                        kanoGroup.position.x += dx * panFactor;
                        kanoGroup.position.y -= dy * panFactor;
                    } else {
                        kanoGroup.rotation.y += dx * rotateFactor;
                        kanoGroup.rotation.x += dy * rotateFactor;
                    }
                    
                    prevMouse = { x: e.clientX, y: e.clientY };
                });
                
                window.addEventListener('mouseup', () => {
                    isDragging = false;
                    dragMode = 'none';
                    renderer.domElement.style.cursor = 'grab';
                });
                
                renderer.domElement.style.cursor = 'grab';
                
                // Scroll ile zoom
                renderer.domElement.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    const zoomSpeed = 0.3;
                    camera.position.z += e.deltaY > 0 ? zoomSpeed : -zoomSpeed;
                    camera.position.z = Math.max(5, Math.min(18, camera.position.z));
                }, { passive: false });
                
                // Mobil dokunmatik destek
                let prevTouch = { x: 0, y: 0 };
                let touchMode = 'none';
                renderer.domElement.addEventListener('touchstart', (e) => {
                    if (e.touches.length === 1) {
                        isDragging = true;
                        prevTouch = { x: e.touches[0].clientX, y: e.touches[0].clientY };
                        const originScreen = getOriginScreenPos();
                        const dist = Math.sqrt(
                            Math.pow(e.touches[0].clientX - originScreen.x, 2) + 
                            Math.pow(e.touches[0].clientY - originScreen.y, 2)
                        );
                        touchMode = dist < CENTER_RADIUS ? 'pan' : 'rotate';
                    }
                });
                renderer.domElement.addEventListener('touchmove', (e) => {
                    if (!isDragging || e.touches.length !== 1) return;
                    const dx = e.touches[0].clientX - prevTouch.x;
                    const dy = e.touches[0].clientY - prevTouch.y;
                    if (touchMode === 'pan') {
                        kanoGroup.position.x += dx * panFactor;
                        kanoGroup.position.y -= dy * panFactor;
                    } else {
                        kanoGroup.rotation.y += dx * rotateFactor;
                        kanoGroup.rotation.x += dy * rotateFactor;
                    }
                    prevTouch = { x: e.touches[0].clientX, y: e.touches[0].clientY };
                });
                renderer.domElement.addEventListener('touchend', () => { isDragging = false; touchMode = 'none'; });
            })();
            
            // Işıklandırma
            const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
            dirLight.position.set(2, 5, 5);
            scene.add(dirLight);
            
            const ambLight = new THREE.AmbientLight(0xffffff, 0.45);
            scene.add(ambLight);
            
            // === EKSEN ÇİZGİLERİ (NET VE KALIN) ===
            
            // Yatay Eksen (X): EKSİK İŞLEV → TAM İŞLEV
            const xAxisMat = new THREE.LineBasicMaterial({ color: 0x4682ff, linewidth: 2 });
            const xAxisGeom = new THREE.BufferGeometry().setFromPoints([
                new THREE.Vector3(-3.2, 0, 0.01),
                new THREE.Vector3(3.2, 0, 0.01)
            ]);
            kanoGroup.add(new THREE.Line(xAxisGeom, xAxisMat));
            
            // X ekseni ok başlığı
            const xArrowGeom = new THREE.ConeGeometry(0.06, 0.2, 8);
            const xArrowMat = new THREE.MeshBasicMaterial({ color: 0x4682ff });
            const xArrow = new THREE.Mesh(xArrowGeom, xArrowMat);
            xArrow.position.set(3.2, 0, 0.01);
            xArrow.rotation.z = -Math.PI / 2;
            kanoGroup.add(xArrow);
            
            // Dikey Eksen (Y): DÜŞÜK MEMNUNİYET → YÜKSEK MEMNUNİYET
            const yAxisGeom = new THREE.BufferGeometry().setFromPoints([
                new THREE.Vector3(0, -2.5, 0.01),
                new THREE.Vector3(0, 2.8, 0.01)
            ]);
            kanoGroup.add(new THREE.Line(yAxisGeom, xAxisMat));
            
            // Y ekseni ok başlığı
            const yArrow = new THREE.Mesh(xArrowGeom.clone(), xArrowMat.clone());
            yArrow.position.set(0, 2.8, 0.01);
            kanoGroup.add(yArrow);
            
            // Eksen kısa çizgileri (tick marks)
            const tickMat = new THREE.LineBasicMaterial({ color: 0x334477, linewidth: 1 });
            for (let i = -3; i <= 3; i++) {
                if (i === 0) continue;
                // X ekseni tick
                const txGeom = new THREE.BufferGeometry().setFromPoints([
                    new THREE.Vector3(i, -0.08, 0.01), new THREE.Vector3(i, 0.08, 0.01)
                ]);
                kanoGroup.add(new THREE.Line(txGeom, tickMat));
                // Y ekseni tick
                const tyGeom = new THREE.BufferGeometry().setFromPoints([
                    new THREE.Vector3(-0.08, i, 0.01), new THREE.Vector3(0.08, i, 0.01)
                ]);
                kanoGroup.add(new THREE.Line(tyGeom, tickMat));
            }
            
            // Hafif arka plan grid (çok soluk)
            const gridMat = new THREE.LineBasicMaterial({ color: 0x1a2744, linewidth: 1, transparent: true, opacity: 0.3 });
            for (let i = -3; i <= 3; i++) {
                if (i === 0) continue;
                const hGeom = new THREE.BufferGeometry().setFromPoints([
                    new THREE.Vector3(-3.2, i, -0.01), new THREE.Vector3(3.2, i, -0.01)
                ]);
                kanoGroup.add(new THREE.Line(hGeom, gridMat));
                const vGeom = new THREE.BufferGeometry().setFromPoints([
                    new THREE.Vector3(i, -2.5, -0.01), new THREE.Vector3(i, 2.8, -0.01)
                ]);
                kanoGroup.add(new THREE.Line(vGeom, gridMat));
            }
            
            // --- KANO EĞRİLERİ ÇİZİMİ (İyileştirilmiş) ---
            
            // 1. MUST-BE EĞRİSİ (Kırmızı) - Sol altta düz, sağa doğru yavaşça yükselir
            const mustBePoints = [];
            for (let x = -3.0; x <= 3.0; x += 0.05) {
                const y = -2.0 + 1.5 * (1 - Math.exp(-0.8 * (x + 3)));
                mustBePoints.push(new THREE.Vector3(x, Math.min(y, -0.15), 0));
            }
            const mustBeCurve = new THREE.CatmullRomCurve3(mustBePoints);
            const mustBeGeom = new THREE.TubeGeometry(mustBeCurve, 100, 0.025, 12, false);
            const mustBeMat = new THREE.MeshPhongMaterial({ color: 0xef4444, emissive: 0x550000, shininess: 60 });
            const mustBeMesh = new THREE.Mesh(mustBeGeom, mustBeMat);
            kanoGroup.add(mustBeMesh);
            
            // 2. PERFORMANCE EĞRİSİ (Mavi/Cyan) - Düz doğrusal çizgi
            const perfPoints = [
                new THREE.Vector3(-3.0, -2.2, 0),
                new THREE.Vector3(-1.5, -1.1, 0),
                new THREE.Vector3(0, 0, 0),
                new THREE.Vector3(1.5, 1.1, 0),
                new THREE.Vector3(3.0, 2.2, 0)
            ];
            const perfCurve = new THREE.CatmullRomCurve3(perfPoints);
            const perfGeom = new THREE.TubeGeometry(perfCurve, 50, 0.025, 12, false);
            const perfMat = new THREE.MeshPhongMaterial({ color: 0x22d3ee, emissive: 0x003344, shininess: 60 });
            const perfMesh = new THREE.Mesh(perfGeom, perfMat);
            kanoGroup.add(perfMesh);
            
            // 3. DELIGHTER EĞRİSİ (Yeşil) - Sağda dramatik şekilde yükselir
            const delightPoints = [];
            for (let x = -3.0; x <= 3.0; x += 0.05) {
                const y = -1.2 + Math.exp(x * 0.8) * 0.3;
                delightPoints.push(new THREE.Vector3(x, Math.min(y, 2.6), 0));
            }
            const delightCurve = new THREE.CatmullRomCurve3(delightPoints);
            const delightGeom = new THREE.TubeGeometry(delightCurve, 100, 0.025, 12, false);
            const delightMat = new THREE.MeshPhongMaterial({ color: 0x4ade80, emissive: 0x166534, shininess: 60 });
            const delightMesh = new THREE.Mesh(delightGeom, delightMat);
            kanoGroup.add(delightMesh);
            
            // --- GEREKSİNİM KÜRELERİ (NET AYRILMIŞ VE ETİKETLİ) ---
            // Must-Be eğrisi üzerinde (kırmızı)
            // Performance eğrisi üzerinde (cyan)
            // Delighter eğrisi üzerinde (yeşil)
            const nodes = [
                // Must-Be düğümleri - gerçek eğri değerleriyle eşleştirildi
                // y = -2.0 + 1.5*(1-exp(-0.8*(x+3))), max -0.15
                { id: 'FR-01', label: 'FR-01\nBarkod', x: -1.8, y: -1.07, z: 0, color: 0xef4444, curve: 'must-be' },
                { id: 'NFR-SPEED', label: 'NFR\nHız', x: 0.2, y: -0.62, z: 0, color: 0xef4444, curve: 'must-be' },
                { id: 'NFR-SEC', label: 'NFR\nGüvenlik', x: 2.2, y: -0.52, z: 0, color: 0xef4444, curve: 'must-be' },
                
                // Performance düğümleri - doğrusal y = x * 0.733
                { id: 'FR-04', label: 'FR-04\nSepet', x: -0.8, y: -0.587, z: 0, color: 0x22d3ee, curve: 'perf' },
                { id: 'NFR-ACC', label: 'NFR\nKesinlik', x: 1.4, y: 1.027, z: 0, color: 0x22d3ee, curve: 'perf' },
                
                // Delighter düğümü - y = -1.2 + exp(x*0.8)*0.3
                { id: 'FR-06', label: 'FR-06\nMoney App', x: 2.5, y: 1.02, z: 0, color: 0x4ade80, curve: 'delight' }
            ];
            
            const nodeMeshes = [];
            const nodeLabels = []; // HTML etiketleri için
            
            nodes.forEach(n => {
                // Ana küre (daha büyük)
                const geom = new THREE.SphereGeometry(0.10, 32, 32);
                const mat = new THREE.MeshPhongMaterial({
                    color: n.color,
                    emissive: new THREE.Color(n.color).multiplyScalar(0.3),
                    shininess: 100,
                    specular: 0xffffff
                });
                const mesh = new THREE.Mesh(geom, mat);
                mesh.position.set(n.x, n.y, n.z);
                mesh.userData = { id: n.id, baseColor: n.color, label: n.label };
                kanoGroup.add(mesh);
                nodeMeshes.push(mesh);
                
                // Parlayan halka efekti (glow ring)
                const ringGeom = new THREE.RingGeometry(0.14, 0.18, 32);
                const ringMat = new THREE.MeshBasicMaterial({
                    color: n.color,
                    transparent: true,
                    opacity: 0.25,
                    side: THREE.DoubleSide
                });
                const ringMesh = new THREE.Mesh(ringGeom, ringMat);
                ringMesh.position.set(n.x, n.y, n.z + 0.01);
                kanoGroup.add(ringMesh);
                mesh.userData.ring = ringMesh;
                
                // HTML etiket elemanı oluştur
                const labelDiv = document.createElement('div');
                labelDiv.className = 'kano-node-label';
                labelDiv.innerHTML = n.label.replace('\n', '<br>');
                labelDiv.style.cssText = `
                    position: absolute; pointer-events: none; z-index: 20;
                    font-family: 'Montserrat', sans-serif; font-size: 0.6rem; font-weight: 800;
                    color: #fff; text-align: center; line-height: 1.2;
                    background: rgba(0,0,0,0.7); padding: 3px 6px; border-radius: 4px;
                    border: 1px solid rgba(${(n.color >> 16) & 255}, ${(n.color >> 8) & 255}, ${n.color & 255}, 0.6);
                    text-shadow: 0 0 4px rgba(${(n.color >> 16) & 255}, ${(n.color >> 8) & 255}, ${n.color & 255}, 0.8);
                    white-space: nowrap; transform: translate(-50%, -100%);
                `;
                container.appendChild(labelDiv);
                nodeLabels.push({ div: labelDiv, mesh: mesh });
            });
            
            // --- LEGEND (GÖSTERGE TABLOSU) ---
            const legendDiv = document.createElement('div');
            legendDiv.style.cssText = `
                position: absolute; bottom: 15px; right: 15px; z-index: 20;
                background: rgba(5, 9, 20, 0.85); border: 1px solid rgba(70, 130, 255, 0.3);
                border-radius: 10px; padding: 10px 14px; font-family: 'Montserrat', sans-serif;
                font-size: 0.65rem; color: #fff;
            `;
            legendDiv.innerHTML = `
                <div style="font-weight:800; margin-bottom:6px; color:var(--cyan-accent); letter-spacing:0.5px;">EĞRİ TÜRLERİ</div>
                <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                    <span style="width:18px; height:3px; background:#ef4444; border-radius:2px; display:inline-block;"></span>
                    <span style="color:#ef4444; font-weight:700;">Temel (Must-Be)</span>
                </div>
                <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                    <span style="width:18px; height:3px; background:#22d3ee; border-radius:2px; display:inline-block;"></span>
                    <span style="color:#22d3ee; font-weight:700;">Performans (Linear)</span>
                </div>
                <div style="display:flex; align-items:center; gap:6px;">
                    <span style="width:18px; height:3px; background:#4ade80; border-radius:2px; display:inline-block;"></span>
                    <span style="color:#4ade80; font-weight:700;">Çekici (Delighter)</span>
                </div>
            `;
            container.appendChild(legendDiv);
            
            // Etiket pozisyonlarını güncelleme fonksiyonu
            function updateLabelPositions() {
                nodeLabels.forEach(item => {
                    const vector = new THREE.Vector3().copy(item.mesh.position);
                    vector.y += 0.22; // Kürenin biraz üstüne yerleştir
                    vector.applyMatrix4(kanoGroup.matrixWorld);
                    vector.project(camera);
                    
                    const x = (vector.x * 0.5 + 0.5) * container.clientWidth;
                    const y = (-vector.y * 0.5 + 0.5) * container.clientHeight;
                    
                    item.div.style.left = x + 'px';
                    item.div.style.top = y + 'px';
                    
                    // Ekran dışındaysa gizle
                    item.div.style.display = (vector.z > 1 || x < 0 || x > container.clientWidth || y < 0 || y > container.clientHeight) ? 'none' : 'block';
                });
            }
            
            // Raycasting
            const raycaster = new THREE.Raycaster();
            const mouse = new THREE.Vector2();
            
            container.addEventListener('click', (e) => {
                const rect = renderer.domElement.getBoundingClientRect();
                mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                
                raycaster.setFromCamera(mouse, camera);
                const intersects = raycaster.intersectObjects(nodeMeshes);
                
                if (intersects.length > 0) {
                    const target = intersects[0].object;
                    selectKanoReq(target.userData.id, true);
                }
            });
            
            window.selectKanoReq = function(id, fromCanvas = false) {
                nodeMeshes.forEach(m => {
                    m.scale.set(1, 1, 1);
                    m.material.emissive.copy(new THREE.Color(m.userData.baseColor).multiplyScalar(0.3));
                    if (m.userData.ring) {
                        m.userData.ring.material.opacity = 0.25;
                        m.userData.ring.scale.set(1, 1, 1);
                    }
                });
                
                // Etiketleri normal boyuta getir
                nodeLabels.forEach(item => {
                    item.div.style.transform = 'translate(-50%, -100%) scale(1)';
                    item.div.style.opacity = '0.7';
                });
                
                const buttons = document.querySelectorAll('.kano-tab-btn');
                buttons.forEach(btn => btn.classList.remove('active'));
                const activeBtn = document.getElementById(`btn-kano-${id}`);
                if (activeBtn) activeBtn.classList.add('active');
                
                const nodeMesh = nodeMeshes.find(m => m.userData.id === id);
                if (nodeMesh) {
                    nodeMesh.scale.set(1.5, 1.5, 1.5);
                    nodeMesh.material.emissive.setHex(0xffffff);
                    if (nodeMesh.userData.ring) {
                        nodeMesh.userData.ring.material.opacity = 0.6;
                        nodeMesh.userData.ring.scale.set(1.3, 1.3, 1.3);
                    }
                    
                    // Seçilen düğümün etiketini büyüt
                    const activeLabel = nodeLabels.find(item => item.mesh === nodeMesh);
                    if (activeLabel) {
                        activeLabel.div.style.transform = 'translate(-50%, -100%) scale(1.3)';
                        activeLabel.div.style.opacity = '1';
                    }
                    
                    if(!fromCanvas) {
                        const targetPos = new THREE.Vector3().copy(nodeMesh.position).add(new THREE.Vector3(0, 0.2, 4.0));
                        let steps = 0;
                        function smoothCam() {
                            if (steps < 25) {
                                camera.position.lerp(targetPos, 0.12);
                                steps++;
                                requestAnimationFrame(smoothCam);
                            }
                        }
                        smoothCam();
                    }
                }
                
                const data = kanoRequirementsData[id];
                if (data) {
                    detailsContent.innerHTML = `
                        <div class="kano-details-header">
                            <span>${data.name}</span>
                            <span class="kano-details-category ${data.class}">${data.category}</span>
                        </div>
                        <div class="kano-details-desc">${data.desc}</div>
                    `;
                }
            };
            
            selectKanoReq('FR-01');
            
            let clock = new THREE.Clock();
            function run() {
                requestAnimationFrame(run);
                const elapsed = clock.getElapsedTime();
                
                nodeMeshes.forEach(m => {
                    const breathe = 1.0 + Math.sin(elapsed * 2.5 + m.position.x * 2.0) * 0.05;
                    const activeElement = document.querySelector('.kano-tab-btn.active');
                    const activeId = activeElement ? activeElement.id.replace('btn-kano-', '') : 'FR-01';
                    const baseScale = m.userData.id === activeId ? 1.5 : 1.0;
                    m.scale.set(baseScale * breathe, baseScale * breathe, baseScale * breathe);
                    
                    // Halka animasyonu
                    if (m.userData.ring) {
                        const ringBreathe = 1.0 + Math.sin(elapsed * 2.0 + m.position.x) * 0.1;
                        const ringBase = m.userData.id === activeId ? 1.3 : 1.0;
                        m.userData.ring.scale.set(ringBase * ringBreathe, ringBase * ringBreathe, 1);
                    }
                });
                
                // Çok hafif döndürme
                kanoGroup.rotation.y = Math.sin(elapsed * 0.06) * 0.05;
                
                // Etiket pozisyonlarını güncelle
                updateLabelPositions();
                
                renderer.render(scene, camera);
            }
            run();
            
            window.addEventListener('resize', () => {
                camera.aspect = container.clientWidth / container.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(container.clientWidth, container.clientHeight);
            });
        })();
    </script>
</body>
</html>