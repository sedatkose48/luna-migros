            display: flex;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
        }
        .concept-tag {
            background: rgba(249, 115, 22, 0.15);
            color: var(--orange-accent);
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.75rem;
            display: inline-block;
            margin-bottom: 5px;
        }
        .concept-item-box {
            background: rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(255,255,255,0.03);
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 10px;
        }
        .concept-item-box h4 {
            color: #fff;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .logic-step-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .logic-step {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255,255,255,0.03);
            border-radius: 8px;
            padding: 0.75rem;
            position: relative;
        }
        .logic-step-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--green-accent);
            color: var(--bg-deep);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-family: 'Montserrat';
            font-size: 0.85rem;
            flex-shrink: 0;
            box-shadow: 0 0 10px rgba(52, 211, 153, 0.4);
        }
        .logic-step-text {
            font-size: 0.85rem;
            color: #e2e8f0;
            font-weight: 500;
        }
        .logic-step-text strong {
            color: #fff;
        }
        .logic-step-arrow {
            text-align: center;
            font-size: 0.8rem;
            color: var(--green-accent);
            opacity: 0.7;
            margin: 2px 0;
        }
        
        .market-option-card {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 10px;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 5px;
            transition: all 0.3s ease;
