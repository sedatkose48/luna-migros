        <script>
            (function() {
                var bpmnXmlCache = {
                    'to-be': null,
                    'as-is': null
                };

                var currentBPMN = 'to-be';
                var iframeReady = false;

                function getDiagramXml(text) {
                    try {
                        var parser = new DOMParser();
                        var doc = parser.parseFromString(text, "image/svg+xml");
                        var content = doc.documentElement.getAttribute("content");
                        if (content) {
                            return content;
                        }
                    } catch(e) {}
                    return text;
                }

                // Dosyaları çekelim
                fetch('/photos/to-be-bpmn2.0-final.svg')
                    .then(function(r) { return r.text(); })
                    .then(function(text) {
                        bpmnXmlCache['to-be'] = getDiagramXml(text);
                        if (currentBPMN === 'to-be' && iframeReady) {
                            loadDiagramInIframe(bpmnXmlCache['to-be']);
                        }
                    });

                fetch('/photos/vizebpmnguncel.svg')
                    .then(function(r) { return r.text(); })
                    .then(function(text) {
                        bpmnXmlCache['as-is'] = getDiagramXml(text);
                        if (currentBPMN === 'as-is' && iframeReady) {
                            loadDiagramInIframe(bpmnXmlCache['as-is']);
                        }
                    });

                window.addEventListener('message', function(evt) {
                    if (evt.data && evt.data.length > 0) {
                        try {
                            var msg = JSON.parse(evt.data);
                            if (msg.event === 'init') {
                                iframeReady = true;
                                var xml = bpmnXmlCache[currentBPMN];
                                if (xml) {
                                    loadDiagramInIframe(xml);
                                }
                            }
                        } catch(e) {}
                    }
                });

                function loadDiagramInIframe(xml) {
                    var iframe = document.getElementById('bpmn-iframe');
                    if (iframe && iframe.contentWindow) {
                        iframe.contentWindow.postMessage(JSON.stringify({
                            action: 'load',
                            xml: xml,
                            autosave: false
                        }), '*');
                    }
                }

                window.switchProcess = function(type) {
                    if (currentBPMN === type) return;
                    currentBPMN = type;

                    var btnToBe = document.getElementById('btn-to-be');
                    var btnAsIs = document.getElementById('btn-as-is');
                    var sidebar = document.getElementById('bpmn-sidebar');
                    var descToBe = document.getElementById('desc-to-be');
                    var descAsIs = document.getElementById('desc-as-is');
                    var title = document.getElementById('viewer-title');
                    var container = document.getElementById('bpmn-container');

                    // 1. Hologram Out animasyonunu başlat
                    container.classList.add('hologram-out');

                    // 2. 300ms sonra (tam geri çekildiği an) içerikleri ve renkleri değiştir
                    setTimeout(function() {
                        if (type === 'to-be') {
                            btnToBe.style.background = 'rgba(52,211,153,0.15)';
                            btnToBe.style.color = 'var(--green-accent)';
                            btnToBe.style.borderColor = 'var(--green-accent)';
                            
                            btnAsIs.style.background = 'rgba(255,255,255,0.05)';
                            btnAsIs.style.color = 'var(--text-muted)';
                            btnAsIs.style.borderColor = 'rgba(255,255,255,0.1)';

                            sidebar.style.borderLeftColor = 'var(--green-accent)';
                            descToBe.style.display = 'flex';
                            descAsIs.style.display = 'none';
                            title.innerHTML = 'LUNA M-SKT Yeni Süreç (TO-BE)';
                        } else {
                            btnAsIs.style.background = 'rgba(239,68,68,0.15)';
                            btnAsIs.style.color = 'var(--red-accent)';
                            btnAsIs.style.borderColor = 'var(--red-accent)';
                            
                            btnToBe.style.background = 'rgba(255,255,255,0.05)';
                            btnToBe.style.color = 'var(--text-muted)';
                            btnToBe.style.borderColor = 'rgba(255,255,255,0.1)';

                            sidebar.style.borderLeftColor = 'var(--red-accent)';
                            descToBe.style.display = 'none';
                            descAsIs.style.display = 'flex';
                            title.innerHTML = 'M-SKT Eski Süreç (AS-IS)';
                        }

                        var xml = bpmnXmlCache[type];
                        if (xml && iframeReady) {
                            loadDiagramInIframe(xml);
                        }
                    }, 300);

                    // 3. 450ms sonra tekrar öne getir (Hologram In)
                    setTimeout(function() {
                        container.classList.remove('hologram-out');
                    }, 450);
                }
            })();
        </script>

