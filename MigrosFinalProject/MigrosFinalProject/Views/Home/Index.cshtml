        ];

        let currentIndex = 0;
        const elTitle = document.getElementById('us-title'); const elRole = document.getElementById('text-role'); const elWant = document.getElementById('text-want'); const elValue = document.getElementById('text-value'); const elIndicator = document.getElementById('storyIndicator'); const fadeElements = document.querySelectorAll('.fade-content');
        const investContainer = document.getElementById('invest-container'); const gherkinContainer = document.getElementById('gherkin-container'); const mainStage = document.getElementById('mainStage');

        function changeStory(direction) {
            currentIndex += direction;
            if (currentIndex < 0) currentIndex = storiesData.length - 1; if (currentIndex >= storiesData.length) currentIndex = 0;
            fadeElements.forEach(el => el.classList.add('fade-out'));
            setTimeout(() => {
                const data = storiesData[currentIndex];
                elIndicator.innerText = `HİKAYE ${currentIndex + 1} / 3`; elTitle.innerText = data.title;
                elRole.innerHTML = data.role; elWant.innerHTML = data.want; elValue.innerHTML = data.value;
                investContainer.innerHTML = ''; data.invest.forEach(i => { investContainer.innerHTML += `<div class="invest-item"><div class="invest-letter" style="color:${i.c || '#f8b500'}">${i.l}</div><div class="invest-desc"><strong>${i.n}</strong><span>${i.d}</span></div></div>`; });
                gherkinContainer.innerHTML = ''; data.gherkin.forEach(g => { gherkinContainer.innerHTML += `<div class="gherkin-scenario"><span class="scenario-title">${g.t}</span><div class="g-line"><span class="kw" style="color:#f8b500;">Given</span> ${g.g}</div><div class="g-line"><span class="kw" style="color:var(--cyan-accent);">When</span> ${g.w}</div><div class="g-line"><span class="kw" style="color:var(--green-accent);">Then</span> ${g.th}</div></div>`; });
                fadeElements.forEach(el => el.classList.remove('fade-out'));
            }, 300);
        }

        const panelInvest = document.getElementById('panel-invest'); const panelGherkin = document.getElementById('panel-gherkin'); const btnInvest = document.getElementById('btnInvest'); const btnGherkin = document.getElementById('btnGherkin');
        function togglePanel(type) { if (!mainStage.classList.contains('panel-active')) mainStage.classList.add('panel-active'); btnInvest.classList.remove('active'); btnGherkin.classList.remove('active'); panelInvest.classList.remove('active'); panelGherkin.classList.remove('active'); if (type === 'invest') { panelInvest.classList.add('active'); btnInvest.classList.add('active'); } else if (type === 'gherkin') { panelGherkin.classList.add('active'); btnGherkin.classList.add('active'); } }
        function closePanel() { mainStage.classList.remove('panel-active'); btnInvest.classList.remove('active'); btnGherkin.classList.remove('active'); setTimeout(() => { panelInvest.classList.remove('active'); panelGherkin.classList.remove('active'); }, 500); }

        changeStory(0);

        // === ARKA PLAN 3D WEBGL KAMERA YÖRÜNGE UÇUŞU SİMÜLASYONU (Master-Level Frontend) ===
        (function() {
            const canvas = document.getElementById('particles-canvas');
            if (!canvas) return;

            // Scene, Camera, Renderer
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            
            const renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                antialias: true,
                alpha: true
            });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // 3D Spline Eğrisi (Uçuş Yörüngesi - Aşama Aşama Y ekseninde aşağı iner)
            const splinePoints = [
                new THREE.Vector3(0, 0, 40),
                new THREE.Vector3(12, -15, 20),
                new THREE.Vector3(-12, -35, 0),
                new THREE.Vector3(10, -55, -20),
                new THREE.Vector3(-10, -75, -40),
                new THREE.Vector3(12, -95, -60),
                new THREE.Vector3(-8, -115, -80),
                new THREE.Vector3(8, -135, -100),
                new THREE.Vector3(0, -155, -120)
            ];
            const cameraRoute = new THREE.CatmullRomCurve3(splinePoints);

            // Başlangıç Kamera Pozisyonu
            camera.position.copy(cameraRoute.getPointAt(0));

            // Dinamik Yumuşak Glow Dokusu
            function createGlowTexture() {
                const c = document.createElement('canvas');
                c.width = 32;
                c.height = 32;
                const ctx2d = c.getContext('2d');
                const grad = ctx2d.createRadialGradient(16, 16, 0, 16, 16, 16);
                grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
                grad.addColorStop(0.3, 'rgba(255, 255, 255, 0.8)');
                grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
                ctx2d.fillStyle = grad;
                ctx2d.fillRect(0, 0, 32, 32);
                return new THREE.CanvasTexture(c);
            }
            const glowTex = createGlowTexture();

            // Partikül Veri Düzenlemesi (Spline Etrafında Girdap Tüneli)
            const particleCount = 1800;
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(particleCount * 3);
            const colors = new Float32Array(particleCount * 3);

            const colorOrange = new THREE.Color(0xf97316); // Migros Turuncu
            const colorCyan = new THREE.Color(0x22d3ee);   // LUNA Mavi/Cyan
            const colorPurple = new THREE.Color(0xa855f7); // Premium Mor

            for (let i = 0; i < particleCount; i++) {
                const t = i / particleCount;
                const splinePoint = cameraRoute.getPointAt(t);

                // Eğri etrafında helisel / spiral sapma vererek tünel efekti yaratıyoruz
                const angle = Math.random() * Math.PI * 2;
                const radius = 6 + Math.random() * 15; // Tünel çapı
                
                positions[i * 3] = splinePoint.x + Math.cos(angle) * radius;
                positions[i * 3 + 1] = splinePoint.y + Math.sin(angle) * radius + (Math.random() - 0.5) * 4;
                positions[i * 3 + 2] = splinePoint.z + (Math.random() - 0.5) * 10;

                // Renk dağılımı
                const randColor = Math.random();
                let chosenColor = colorCyan;
                if (randColor > 0.65) chosenColor = colorOrange;
                else if (randColor > 0.45) chosenColor = colorPurple;

                colors[i * 3] = chosenColor.r;
                colors[i * 3 + 1] = chosenColor.g;
                colors[i * 3 + 2] = chosenColor.b;
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

            const material = new THREE.PointsMaterial({
                size: 0.35,
                vertexColors: true,
                map: glowTex,
                transparent: true,
                opacity: 0.65,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            const particles = new THREE.Points(geometry, material);
            scene.add(particles);

            // Fare Etkileşimi Değişkenleri
            let targetMouse = { x: 0, y: 0 };
            let currentMouse = { x: 0, y: 0 };

            window.addEventListener('mousemove', (e) => {
                targetMouse.x = (e.clientX - window.innerWidth / 2) * 0.008;
                targetMouse.y = (e.clientY - window.innerHeight / 2) * 0.008;
            });

            // Kaydırma (Scroll) Yönetimi
            let targetScrollProgress = 0;
            let currentScrollProgress = 0;

            function updateScrollProgress() {
                const scrollTop = window.scrollY || document.documentElement.scrollTop;
                const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
                if (scrollHeight > 0) {
                    targetScrollProgress = scrollTop / scrollHeight;
                }
            }

            window.addEventListener('scroll', updateScrollProgress);
            updateScrollProgress();

            // Render Döngüsü
            const clock = new THREE.Clock();

            function animate() {
                requestAnimationFrame(animate);

                const elapsed = clock.getElapsedTime();

                // İnertial (Yumuşak) Interpolasyonlar (Lerp)
                currentScrollProgress += (targetScrollProgress - currentScrollProgress) * 0.06;
                currentMouse.x += (targetMouse.x - currentMouse.x) * 0.05;
                currentMouse.y += (targetMouse.y - currentMouse.y) * 0.05;

                // Kamera pozisyonunu spline üzerindeki kaydırma yüzdesine göre belirle
                const camPos = cameraRoute.getPointAt(currentScrollProgress);
                camera.position.copy(camPos);

                // Kameranın bakacağı hedefi (LookAt) biraz ilerideki yörünge noktası yap (Akıcı dönüşler sağlar)
                const lookAheadProgress = Math.min(currentScrollProgress + 0.03, 0.999);
                const lookAtTarget = cameraRoute.getPointAt(lookAheadProgress);
                
                // Fare hareketine bağlı mikro sarsıntı / kayma efekti (Parallax)
                camera.position.x += currentMouse.x;
                camera.position.y += -currentMouse.y;
                
                camera.lookAt(lookAtTarget);

                // Partiküllerin kendi etrafında yavaşça süzülme hareketi
                particles.rotation.y = elapsed * 0.005;
                particles.rotation.z = elapsed * 0.003;

                renderer.render(scene, camera);
            }

            animate();

            // Yeniden Boyutlandırma
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        })();

