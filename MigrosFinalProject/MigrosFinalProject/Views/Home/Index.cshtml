            {
                id: 3, title: "US03: SON ŞANS SEKMESİ (Sanal Market)", roleIcon: "🌍", role: "Fırsat takip eden Migros kullanıcısı olarak,",
                wantIcon: "🏷️", want: "SKT'si yaklaşan ürünlerin <span class='highlight'>yüksek indirimlerle listelendiği</span> özel bir 'Son Şans' sekmesi görmek istiyorum.",
                valueIcon: "📉", value: "Bugün tüketeceğim ürünleri uygun fiyata alırken <span class='highlight'>israfı azaltmaya katkıda bulunmak istiyorum.</span>",
                invest: [
                    { l: "I", c: "", n: "Independent", d: "Kategori yapısından ayrı çalışabilir." }, { l: "N", c: "#22d3ee", n: "Negotiable", d: "Hangi ürünlerin dahil edileceği değişebilir." }, { l: "V", c: "#34d399", n: "Valuable", d: "Kırmızı alarma geçen stoklar eritilir." },
                    { l: "E", c: "", n: "Estimable", d: "Sorgu algoritmasının yükü nettir." }, { l: "S", c: "#22d3ee", n: "Small", d: "Sadece yeni bir query yazılacaktır." }, { l: "T", c: "#34d399", n: "Testable", d: "Ürünlerin sekmeye otomatik düştüğü test edilir." }
                ],
                gherkin: [
                    { t: "Senaryo 1: Sekmeye Düşmesi", g: "SKT'ye tam 2 gün kaldığında,", w: "Gece güncellemesi çalıştığında,", th: "Ürün Son Şans kategorisine eklenmelidir." },
                    { t: "Senaryo 2: Süresi Dolan Ürün", g: "SKT tarihi geçmiş ise,", w: "Kullanıcı sayfayı yenilediğinde,", th: "Ürün listeden tamamen kaldırılmalıdır." },
                    { t: "Senaryo 3: Maksimum Alım Limiti", g: "Sepete ekleme yaparken,", w: "Adil dağıtım limitinin üzerinde seçtiğinde,", th: "Artı butonu pasif olmalı ve uyarı çıkmalıdır." }
                ]
